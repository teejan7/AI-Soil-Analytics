# PostgreSQL connection. Use either DATABASE_URL or the component variables below.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/soilcare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soilcare

# Comma-separated browser origins allowed by FastAPI.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
